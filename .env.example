# Copy to your hosting provider's environment settings. All values are optional locally.

# HTTP port (most hosts set this automatically)
PORT=3000

# Secret used to sign session tokens. REQUIRED in production - use a long random string.
JWT_SECRET=

# Folder for the SQLite database (point this at a persistent disk in production)
DATA_DIR=./data

# Set to "off" to disable the demo account and the "Log in as demo user" button
DEMO_ACCOUNT=on
